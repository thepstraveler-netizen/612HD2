# Copy to .env.local for development. Never commit real values.
# Variables without NEXT_PUBLIC_ are server-only and must never reach the browser.

# --- Required for Phase 1 ---------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server only (bootstrap script, webhooks, cron)

# Google OAuth client id/secret are configured in the Supabase dashboard
# (Authentication > Providers > Google), not in this app.

# --- Phase 4: online booking -------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=                  # server only
RAZORPAY_WEBHOOK_SECRET=              # server only
RESEND_API_KEY=                       # optional: booking emails
NOTIFY_FROM_EMAIL=                    # e.g. "P&S Traveler <bookings@yourdomain>"

# --- Used from later phases (documented now so environments are set up once) --
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
UPSTASH_REDIS_REST_URL=               # optional (Phase 11): rate limits in Upstash instead of the database
UPSTASH_REDIS_REST_TOKEN=             # server only
NEXT_PUBLIC_TURNSTILE_SITE_KEY=       # optional (Phase 11): Cloudflare Turnstile on public forms
TURNSTILE_SECRET_KEY=                 # server only; Turnstile runs only when both keys are set
CRON_SECRET=                          # not needed yet: hold expiry runs in pg_cron

# --- Phase 11: SMS, WhatsApp and error reporting (all optional) ------------
# Without these, SMS / WhatsApp are logged as "skipped" and errors go to the log.
# Per-notification template ids live in the `notifications.providers` setting.
MSG91_AUTH_KEY=                       # server only: MSG91 Flow API auth key
MSG91_SENDER_ID=                      # optional 6-letter DLT sender id (else the flow's own)
WHATSAPP_CLOUD_TOKEN=                 # server only: permanent system-user token
WHATSAPP_PHONE_NUMBER_ID=             # WhatsApp Business phone number id (not the number)
WHATSAPP_API_VERSION=                 # optional, default v21.0
SENTRY_DSN=                           # server errors (Sentry envelope API, no SDK)
NEXT_PUBLIC_SENTRY_DSN=               # browser errors (public by design; may equal SENTRY_DSN)
SENTRY_SAMPLE_RATE=1                  # 0..1, share of server errors sent
NEXT_PUBLIC_SENTRY_SAMPLE_RATE=1      # 0..1, share of browser errors sent
